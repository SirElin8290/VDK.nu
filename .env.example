PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
DB_PATH=./data/vdk.sqlite
SEASON=2026/27
# Exakt webbursprung om den publika sidan ligger på GitHub Pages.
ALLOWED_ORIGINS=
# Fyll i VDK:s riktiga Swish-nummer före medlemsansökningar öppnas.
SWISH_NUMBER=
# Resend API-nyckel och verifierad avsändare för aktiverings- och återställningslänkar.
RESEND_API_KEY=
EMAIL_FROM=
# Skapa första admin med: node --env-file=.env server/create-admin.mjs
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Automatiskt varje måndag kl 03 svensk tid när medlemsservern körs.
STATS_SYNC_ENABLED=false
STATS_SEASON_IDS=43,44
# Värmland och Svenska IBF; lägg till andra distrikt för medlemmar som dömer där.
STATS_FEDERATION_IDS=11,1

# Endast detta befintliga ADMIN-konto kan utse fler administratörer.
OWNER_ADMIN_EMAIL=sorenjohansson@outlook.com
